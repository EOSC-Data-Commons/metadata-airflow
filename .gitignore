.cache_ggshield
# Environment / secrets
.env
.env.*
!.env.example

# Airflow runtime data
logs/
backups/

# Local DAGs (GitDagBundle is used instead)
dags/

# Local plugins/config if not versioned
plugins/
config/airflow.cfg

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# IDE / editor
.vscode/
.idea/
*.swp
*.swo

# macOS
.DS_Store

# Docker / local overrides
docker-compose.override.yml
*.override.*

# Temporary files
*.log
*.tmp
*.bak
